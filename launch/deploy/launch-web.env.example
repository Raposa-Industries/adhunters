# /etc/adhunters/launch-web.env (owner-only). See launch/README.md.
# The launch login on the data box's Postgres; Launch owns the launch
# schema and applies its migrations at start.
DATABASE_URL=postgres://launch:FILL_ME@10.20.1.20:5432/adhunters?sslmode=require
LAUNCH_WEB_ADDR=127.0.0.1:8094
OPS_ADDR=127.0.0.1:9111
# How often moves are checked for copies a person has started.
LAUNCH_WATCH_EVERY=5m
# The library's API on this box (library/), for Novo par; off for none.
LAUNCH_LIBRARY_URL=http://127.0.0.1:8093

# Taboola Backstage: the server's own login (client id and secret) and the advertiser
# accounts Launch may use, comma separated. A network account (ending in
# -network) is refused at boot. Empty: the pages work, the tree says Taboola
# is not connected, and Novo par still gives the bulk sheet.
# The ZoltaGroup login is the team's live Taboola login since 2026-10-01
# (owner), the same keys create-web holds. TABOOLA_ONLY_OWN stays off so the
# team can manage the campaigns already there; every write is a person's,
# and everything new is made paused.
TABOOLA_CLIENT_ID=
TABOOLA_CLIENT_SECRET=
TABOOLA_ACCOUNTS=
# Ceilings (USD). The owner's rule (2026-10-01): a campaign never spends more
# than $20 in all, so every campaign made or copied gets a total limit of at
# most TABOOLA_MAX_SPEND_LIMIT, and its daily cap is at most that too. Both
# are 20 when unset.
TABOOLA_MAX_CPC=1.00
TABOOLA_MAX_DAILY_CAP=20
TABOOLA_MAX_SPEND_LIMIT=20
# Everything is created paused; a person turns it on in Taboola's dashboard.
#TABOOLA_ONLY_OWN=1
#TABOOLA_NAME_PREFIX=
#TABOOLA_STATE_FILE=/var/lib/launch-web/taboola-state.json
# More Taboola logins are added on the Contas page (/launch/accounts), their
# secrets sealed with this key file, which Launch makes at its first start.
#LAUNCH_LOGIN_KEY=/var/lib/launch-web/login.key
