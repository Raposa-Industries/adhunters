# library settings (library/README.md).
DATABASE_URL=FILL_ME
LIBRARY_ADDR=127.0.0.1:8093
# The team's library folder in Google Drive (the id at the end of its link).
LIBRARY_DRIVE_FOLDER=1ZDULRMNk-5JohCAI_ZG9W5lvvEp8HP3Q
# The "Desktop app" OAuth client of the adhunters-library Google Cloud
# project. Empty: Drive stays off and the library works without it. After
# filling them in, sign in once: sudo /opt/adhunters/bin/library drive-login
LIBRARY_GOOGLE_CLIENT_ID=
LIBRARY_GOOGLE_CLIENT_SECRET=
# For tests only: point the library at a fake Google token endpoint and
# Drive API. Leave both unset in production (empty means Google).
# LIBRARY_GOOGLE_TOKEN_URL=
# LIBRARY_GOOGLE_API_URL=
OPS_ADDR=127.0.0.1:9110
