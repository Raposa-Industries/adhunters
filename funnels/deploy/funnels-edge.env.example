# /etc/adhunters/funnels-edge.env (owner-only). setup.sh makes the key once.
FUNNELS_EDGE_ADDR=127.0.0.1:8095
FUNNELS_SITES=/var/lib/funnels/sites
FUNNELS_SPOOL=/var/lib/funnels/spool
# Keys the hash of visitors' addresses. Keep it: a new one makes every
# address look new.
FUNNELS_IP_KEY=FILL_ME
# Every request comes through the Cloudflare tunnel, so its headers are true.
FUNNELS_TRUST_CLOUDFLARE=1
OPS_ADDR=127.0.0.1:9112
