# Funnels' edge: the hosted landing sites, the page script (/ah.js) and the
# collector (/e). Settings in /etc/adhunters/funnels-edge.env. Listens on
# localhost (FUNNELS_EDGE_ADDR); visitors reach it through the Cloudflare
# tunnel, with no Cloudflare Access in front: landing pages are public.
[Unit]
Description=Funnels edge
Wants=network-online.target
After=network-online.target

[Service]
User=funnels
Group=funnels
EnvironmentFile=-/etc/adhunters/observe.env
EnvironmentFile=/etc/adhunters/funnels-edge.env
ExecStart=/opt/adhunters/bin/funnels-edge run
Restart=always
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/funnels/spool
ReadOnlyPaths=/var/lib/funnels/sites

[Install]
WantedBy=multi-user.target
