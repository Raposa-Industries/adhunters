# /etc/adhunters/funnels-web.env (root and the funnels group). setup.sh fills
# the database password: the funnels_web login, which only reads.
DATABASE_URL=postgres://funnels_web:FILL_ME@localhost:5432/adhunters?sslmode=require
FUNNELS_WEB_ADDR=127.0.0.1:8099
FUNNELS_SITES=/var/lib/funnels/sites
OPS_ADDR=127.0.0.1:9123
