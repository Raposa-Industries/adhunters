# Funnels' pages under /funnels/. Settings in /etc/adhunters/funnels-web.env.
# Listens on localhost (FUNNELS_WEB_ADDR); people reach it through the
# Cloudflare tunnel, behind Cloudflare Access. It reads the hosted sites'
# folder for the hosting page and writes nothing.
[Unit]
Description=Funnels web
Wants=network-online.target
After=network-online.target

[Service]
User=funnels
Group=funnels
EnvironmentFile=-/etc/adhunters/observe.env
EnvironmentFile=/etc/adhunters/funnels-web.env
ExecStart=/opt/adhunters/bin/funnels-web
Restart=always
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/var/lib/funnels/sites
InaccessiblePaths=/var/lib/funnels/spool

[Install]
WantedBy=multi-user.target
