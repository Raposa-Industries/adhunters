# /etc/adhunters/funnels-loader.env (owner-only). setup.sh fills in the
# login and copies the object storage keys from tracks-loader.env.
DATABASE_URL=FILL_ME
FUNNELS_ARCHIVE=s3://adhunters-raw/funnels
FUNNELS_SPOOL=/var/lib/funnels/spool
S3_ENDPOINT=fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_ACCESS_KEY=FILL_ME
S3_SECRET_KEY=FILL_ME
OPS_ADDR=127.0.0.1:9113
