# /etc/adhunters/intel-collect.env (owner-only). The login owns the intel
# schemas (intel-numbers migrates them).
DATABASE_URL=postgres://intel:FILL_ME@10.20.1.20:5432/adhunters?sslmode=require
INTEL_SPOOL=/var/lib/intel-collect/spool
# Taboola: one name per login, each with its own client id and secret.
# Intel only reads. A lent login stays read-only whatever its key allows.
TABOOLA_LOGINS=zoltagroup
TABOOLA_ZOLTAGROUP_CLIENT_ID=FILL_ME
TABOOLA_ZOLTAGROUP_CLIENT_SECRET=FILL_ME
# Intel's share of each login's 84 requests a minute (the rest is Launch's).
INTEL_TABOOLA_PER_MINUTE=40
INTEL_TABOOLA_REALTIME_PER_MINUTE=8
# RedTrack: one name per account. Only GETs ever leave.
REDTRACK_LOGINS=team
REDTRACK_TEAM_API_KEY=FILL_ME
OPS_ADDR=127.0.0.1:9110
