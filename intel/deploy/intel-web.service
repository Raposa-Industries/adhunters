# Intel's pages under /intel/. Listens on localhost (INTEL_WEB_ADDR);
# people reach it through the Cloudflare tunnel, behind Cloudflare Access.
# Settings in /etc/adhunters/intel-web.env.
[Unit]
Description=Intel web
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=-/etc/adhunters/observe.env
EnvironmentFile=/etc/adhunters/intel-web.env
ExecStart=/opt/adhunters/bin/intel-web
Restart=always
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
