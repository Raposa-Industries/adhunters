# Loads the kept answers into tables and works out results, alerts and
# suggestions every 2 minutes. Never talks to Taboola or RedTrack. Settings
# in /etc/adhunters/intel-numbers.env. Migrations run before each start.
[Unit]
Description=Intel numbers
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=-/etc/adhunters/observe.env
EnvironmentFile=/etc/adhunters/intel-numbers.env
ExecStartPre=/opt/adhunters/bin/intel-numbers migrate
ExecStart=/opt/adhunters/bin/intel-numbers run
Restart=always
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
