# /etc/adhunters/intel-numbers.env (owner-only). The login owns the intel
# schemas and has the launch_api_read role (moved campaigns).
DATABASE_URL=postgres://intel:FILL_ME@10.20.1.20:5432/adhunters?sslmode=require
INTEL_EVERY=2m
# Alerts, delivery status changes and suggestions go to the ops group
# "AdHunters operation" (OPS_TELEGRAM_CHAT_ID), or to TELEGRAM_CHAT_ID
# ("AdHunters alerts") while that is empty. No token: the pages only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPS_TELEGRAM_CHAT_ID=
# Links in alert messages start here.
INTEL_BASE_URL=https://hunt-teste.fyi
OPS_ADDR=127.0.0.1:9114
