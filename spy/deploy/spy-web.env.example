# /etc/adhunters/spy-web.env (owner-only). Its own login, which only reads:
# spy_api_read, tracks_api_read, raposa_api_read, and EXECUTE on
# raposa_api.request_investigation_v1 (the "Investigar" button).
DATABASE_URL=postgres://spy_web:FILL_ME@10.20.1.20:5432/adhunters?sslmode=require
SPY_WEB_ADDR=127.0.0.1:8095
# Cloudflare Access: the team's address and the application's AUD tag.
# Leave both empty only while it listens on localhost.
ACCESS_TEAM=https://FILL_ME.cloudflareaccess.com
ACCESS_AUD=FILL_ME
OPS_ADDR=127.0.0.1:9111
