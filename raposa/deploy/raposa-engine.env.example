# /etc/adhunters/raposa-engine.env (owner-only). The login needs the
# tracks_api_read role and owns the raposa schemas.
DATABASE_URL=postgres://raposa:FILL_ME@10.20.1.20:5432/adhunters?sslmode=require
WORKERS=10
# Watched events go to the ops group "AdHunters operation": the bot's token
# and the group's chat id (as in observe-bot.env). Empty: they are recorded
# as skipped. Links in them start at RAPOSA_BASE_URL, where raposa-web is.
TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
RAPOSA_BASE_URL=https://hunt-teste.fyi/raposa
# Where kept files go. file:///var/lib/raposa/files, or object storage:
RAPOSA_FILES=s3://adhunters-raposa
S3_ENDPOINT=fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_ACCESS_KEY=FILL_ME
S3_SECRET_KEY=FILL_ME
RAPOSA_BROWSER=http://127.0.0.1:8086
RAPOSA_KEEP_DIR=/var/lib/raposa/keep
OPS_ADDR=127.0.0.1:9105
