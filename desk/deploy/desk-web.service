# Desk's pages under /desk/. Settings in /etc/adhunters/desk-web.env.
# Listens on localhost (DESK_WEB_ADDR); people reach it through the
# Cloudflare tunnel, behind Cloudflare Access, which says who is asking.
# Desk's migrations run before each start (desk-agent's run them too, under
# the same lock), so the pages work while Desk is off (no Claude key).
[Unit]
Description=Desk web
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=-/etc/adhunters/observe.env
EnvironmentFile=/etc/adhunters/desk-web.env
ExecStartPre=/opt/adhunters/bin/desk-agent migrate
ExecStart=/opt/adhunters/bin/desk-web
Restart=always
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
