# /etc/adhunters/desk-agent.env (owner-only). See desk/README.md.
# The login owns the desk schemas and holds the _api_read role of every app
# in contract/actions (raposa_api_read, spy_api_read, tracks_api_read), so
# Desk reads and calls what a teammate's page does and nothing more.
DATABASE_URL=postgres://desk:FILL_ME@10.20.1.20:5432/adhunters?sslmode=require
# The Claude key. The day's spending cap and the stop switch are on the
# settings page (/desk/settings), not here.
ANTHROPIC_API_KEY=
# Conversations answered at once.
TURNS=2
OPS_ADDR=127.0.0.1:9120
