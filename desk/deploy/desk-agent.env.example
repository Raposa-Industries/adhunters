# /etc/adhunters/desk-agent.env (owner-only). See desk/README.md.
# The desk login: it owns the desk schemas and holds the _api_read role of
# every app in contract/actions, so Desk reads and calls what a teammate's
# page does and nothing more. setup.sh fills this in on the data box.
DATABASE_URL=FILL_ME
# The Claude key. Empty, Desk is off: desk-agent runs but takes no work.
# Put the key in, then systemctl restart desk-agent. The day's spending
# limit and the stop switch are on the settings page (/desk/settings).
ANTHROPIC_API_KEY=
# Conversations answered at once.
TURNS=2
OPS_ADDR=127.0.0.1:9120
