# /etc/adhunters/desk-web.env (owner-only). See desk/README.md.
# The same login as desk-agent (the pages only touch Desk's own tables);
# setup.sh fills this in on the data box.
DATABASE_URL=FILL_ME
DESK_WEB_ADDR=127.0.0.1:8092
OPS_ADDR=127.0.0.1:9121
# Cloudflare Access: the team's address (https://<team>.cloudflareaccess.com)
# and the AUD tag of the Access application in front of /desk. Every request
# must then carry Access's token, and its email is who is asking. Empty, Desk
# is off: every page says to sign in. Fill both when Desk is turned on.
ACCESS_TEAM=
ACCESS_AUD=
# Never on a server: on a laptop without Access, the email every visitor is.
#DESK_DEV_PERSON=
