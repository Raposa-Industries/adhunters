# /etc/adhunters/create-web.env (owner-only). See create/README.md.
# Since 2026-10-01 create-web is the team's sign-in in front of every app on
# hunt-teste.fyi and reads just SIGNIN_USER, SIGNIN_PASSWORD_HASH,
# CREATE_WEB_ADDR and OPS_ADDR; the rest stays until the file is cleaned up.
# The sign-in: one username, and the hash of its password, printed by
#   printf '%s' "$P" | create-web hash-password
# Never the password itself. It refuses to start without both.
SIGNIN_USER=FILL_ME
SIGNIN_PASSWORD_HASH=FILL_ME
# The OpenAI key. Empty: the page works for uploads and typed headlines,
# and making options is off.
OPENAI_API_KEY=
CREATE_WEB_ADDR=127.0.0.1:8091
OPS_ADDR=127.0.0.1:9109
# Every OpenAI reply and every Taboola request and answer is kept here, as
# received, before it is read.
CREATE_KEEP_DIR=/var/lib/create-web/kept

# Taboola Backstage. These are the credentials of ONE Taboola login (Backstage
# API client id and secret), and TABOOLA_ACCOUNTS are that login's advertiser
# accounts the page may use, comma separated (acme-sc,acme-2-sc). A network
# account (ending in -network) is refused at boot. Empty: the page works and
# the Taboola routes say Taboola is not connected.
# The ZoltaGroup login is the team's live Taboola login since 2026-10-01
# (owner), the same keys launch-web holds. TABOOLA_ONLY_OWN stays off on it;
# everything created here is paused.
TABOOLA_CLIENT_ID=
TABOOLA_CLIENT_SECRET=
TABOOLA_ACCOUNTS=
# Ceilings for a new campaign (USD). The owner's rule (2026-10-01): a campaign
# never spends more than $20 in all (both 20 when unset).
TABOOLA_MAX_CPC=1.00
TABOOLA_MAX_DAILY_CAP=500
TABOOLA_MAX_SPEND_LIMIT=0
# Everything is created paused; a person turns it on in Taboola's dashboard.

# Only for a login lent for tests, never the team's own: only campaigns and
# groups made here (recorded in the state file) are listed or touched;
# nothing else in the account is ever shown or changed. The name prefix is
# optional.
#TABOOLA_ONLY_OWN=1
#TABOOLA_NAME_PREFIX=
#TABOOLA_STATE_FILE=/var/lib/create-web/kept/taboola-state.json
