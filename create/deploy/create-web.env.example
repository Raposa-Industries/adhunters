# /etc/adhunters/create-web.env (owner-only). See create/README.md.
# The OpenAI key. Empty: the page works for uploads and typed headlines,
# and making options is off.
OPENAI_API_KEY=
CREATE_WEB_ADDR=127.0.0.1:8091
OPS_ADDR=127.0.0.1:9109
# Every OpenAI reply is kept here, as received, before it is read.
CREATE_KEEP_DIR=/var/lib/create-web/kept
