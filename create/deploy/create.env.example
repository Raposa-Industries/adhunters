# /etc/adhunters/create.env (owner-only). See create/README.md.
# The create_app login; setup.sh fills it in when it makes the login.
DATABASE_URL=FILL_ME
# The OpenAI key. Empty: the pages work, and making options is off.
OPENAI_API_KEY=
CREATE_ADDR=127.0.0.1:8095
OPS_ADDR=127.0.0.1:9112
# References and the pictures made, kept on the data box's disk. What the
# team keeps is saved into the library, which has its own bucket.
CREATE_FILES=file:///var/lib/create/files
# Every OpenAI reply, kept as it came before it is read.
CREATE_KEEP_DIR=/var/lib/create/kept
LIBRARY_URL=http://127.0.0.1:8093
# Models and quality (defaults: gpt-image-2.5-flare, medium, gpt-5-mini, low).
#CREATE_IMAGE_MODEL=
#CREATE_IMAGE_QUALITY=
#CREATE_TEXT_MODEL=
#CREATE_TEXT_REASONING=
# Jobs run at once, pictures included (1 to 10).
#CREATE_WORKERS=3
