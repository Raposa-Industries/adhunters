# The team's sign-in in front of every app on hunt-teste.fyi. Settings in
# /etc/adhunters/create-web.env. Listens on localhost (CREATE_WEB_ADDR);
# people reach it through the Cloudflare tunnel.
[Unit]
Description=Create web (sign-in for hunt-teste.fyi)
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
StateDirectory=create-web
EnvironmentFile=-/etc/adhunters/observe.env
EnvironmentFile=/etc/adhunters/create-web.env
ExecStart=/opt/adhunters/bin/create-web
Restart=always
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
