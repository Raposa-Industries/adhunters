# Posts the 08:00 digest and new Sentry issues to the Telegram group
# "AdHunters alerts", and reads the balances in /etc/adhunters/credits.conf for
# the credit alerts, and posts each change to Taboola's policy pages. Settings and tokens are in /etc/adhunters/observe-bot.env.
[Unit]
Description=Observe bot (digest, Sentry relay, credit checks and policy watch)
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
StateDirectory=observe-bot
EnvironmentFile=-/etc/adhunters/observe.env
EnvironmentFile=/etc/adhunters/observe-bot.env
ExecStart=/opt/adhunters/bin/observe-bot run
Restart=always
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
