# Posts the 08:00 digest and new Sentry issues to the Telegram group
# "AdHunters alerts". Settings and tokens are in /etc/adhunters/observe-bot.env.
[Unit]
Description=Observe bot (digest and Sentry relay)
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
StateDirectory=observe-bot
EnvironmentFile=-/etc/adhunters/observe.env
EnvironmentFile=/etc/adhunters/observe-bot.env
ExecStart=/opt/adhunters/bin/observe-bot run
Restart=always
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
