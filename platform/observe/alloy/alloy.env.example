# /etc/adhunters/alloy.env (root only). Written once by setup.sh; Alloy starts
# when no FILL_ME is left. Values come from the Grafana Cloud stack's page
# (Home > Stacks > your stack): "Prometheus" and "Loki" each show a URL and a
# user number. The token is one access policy token with metrics:write and
# logs:write.
GRAFANA_METRICS_URL=FILL_ME
GRAFANA_METRICS_USER=FILL_ME
GRAFANA_LOGS_URL=FILL_ME
GRAFANA_LOGS_USER=FILL_ME
GRAFANA_CLOUD_TOKEN=FILL_ME
# Data box only; setup.sh fills it in when it creates the observe login.
POSTGRES_MONITOR_URL=FILL_ME
