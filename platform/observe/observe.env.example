# Copy to platform/observe/observe.env (git ignores it) and fill in. push.sh
# reads it; nothing here goes to the boxes.
#
# Grafana Cloud stack page (grafana.com > My Account > your stack):
#   "Prometheus" card > Details: the URL and the user number.
GRAFANA_PROMETHEUS_URL=FILL_ME
GRAFANA_PROMETHEUS_USER=FILL_ME
#   "Alertmanager" (Alerting) card > Details: its URL and user number.
GRAFANA_ALERTMANAGER_URL=FILL_ME
GRAFANA_ALERTMANAGER_USER=FILL_ME
#   An access policy token with rules:read, rules:write, alerts:read and
#   alerts:write (not the boxes' metrics:write token).
GRAFANA_RULES_TOKEN=FILL_ME
# Grafana itself (https://<stack>.grafana.net) and a service account token
# with the Editor role, for the dashboards.
GRAFANA_URL=FILL_ME
GRAFANA_DASHBOARDS_TOKEN=FILL_ME
# The Telegram bot's token (from @BotFather) and the "AdHunters alerts"
# group's chat id (a negative number).
TELEGRAM_BOT_TOKEN=FILL_ME
TELEGRAM_CHAT_ID=FILL_ME
# The Better Stack heartbeat's URL.
BETTERSTACK_HEARTBEAT_URL=FILL_ME
