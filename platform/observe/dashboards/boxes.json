        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (box) (rate(node_disk_written_bytes_total{box=~\"$box\"}[5m]))",
          "legendFormat": "{{box}}"
        }
      ]
    },
    {
      "id": 5,
