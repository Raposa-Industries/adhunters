{
  "uid": "adhunters-boxes",
  "title": "AdHunters · Boxes",
  "description": "Hosts (CPU, memory, disks, network, pressure, processes, units, clock), services, Postgres, backups, Raposa and Alloy.",
  "tags": [
    "adhunters"
  ],
  "timezone": "utc",
  "refresh": "1m",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "box",
        "label": "Box",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(node_boot_time_seconds, box)",
          "refId": "box"
        },
        "definition": "label_values(node_boot_time_seconds, box)",
        "includeAll": true,
        "multi": true,
        "current": {},
        "refresh": 2,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU busy",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - avg by (box) (rate(node_cpu_seconds_total{mode=\"idle\",box=~\"$box\"}[5m]))",
          "legendFormat": "{{box}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory available",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_memory_MemAvailable_bytes{box=~\"$box\"} / node_memory_MemTotal_bytes{box=~\"$box\"}",
          "legendFormat": "{{box}}"
        }
      ]
    },
    {
      "id": 3,
