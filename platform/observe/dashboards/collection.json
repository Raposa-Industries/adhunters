    {
      "id": 7,
      "type": "timeseries",
      "title": "Failed share by network",
      "description": "The red line is where CaptureErrors fires.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (network) (rate(tracks_capture_scrapes_total{outcome!~\"ok|empty\"}[15m])) / sum by (network) (rate(tracks_capture_scrapes_total[15m]))",
          "legendFormat": "{{network}}"
        }
