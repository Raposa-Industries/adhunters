+-- ==============================================================================
+-- AdHunters Schema Migration: 042_walk_queue.sql
+-- Sequential ID: 042
+-- Topology Directive: Runs exclusively on prodbox (adplatform_v2)
+--
+-- Scraping moves to Tracks (Raposa-Industries/adhunters). Its bridge,
+-- tracks-bridge, writes every scrape into spy the way the sweeper did, and
+-- files each ad's click link here, because the landing page walker lived on
+-- the sweeper's in-memory feed. With SWEEPER_CONCURRENCY=0 the collector
+-- stops scraping and reads this table instead (cmd/collector).
+--
+-- One row per ad: the newest link, and when it was filed. The bridge files an
+-- ad again at most every 10 minutes; the collector drops rows older than an
+-- hour. Nothing else reads it. While the sweeper runs, nothing writes it.
+-- ==============================================================================
+
+CREATE TABLE IF NOT EXISTS spy.walk_queue (
+    ad_id INTEGER PRIMARY KEY,
+    creative_id INTEGER NOT NULL,
+    account_id INTEGER,
+    click_url TEXT NOT NULL,
+    referer TEXT NOT NULL DEFAULT '',
+    queued_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+CREATE INDEX IF NOT EXISTS idx_spy_walk_queue_queued ON spy.walk_queue(queued_at);
