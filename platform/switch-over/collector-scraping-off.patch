@@ -242,3 +242,38 @@ func (r *LandersRepository) WalkedAds(ctx context.Context) (map[int32]time.Time,
 	}
 	return walked, rows.Err()
 }
+
+// WalkRequest is one ad's click link, filed in spy.walk_queue (042) by
+// tracks-bridge while Tracks scrapes instead of the sweeper.
+type WalkRequest struct {
+	CreativeID int32
+	AdID       int32
+	AccountID  int32
+	ClickURL   string
+	Referer    string
+	QueuedAt   time.Time
+}
+
+// WalkQueue returns the requests filed after since, oldest first, and drops
+// those older than an hour.
+func (r *LandersRepository) WalkQueue(ctx context.Context, since time.Time) ([]WalkRequest, error) {
+	if _, err := r.client.pool.Exec(ctx, `DELETE FROM spy.walk_queue WHERE queued_at < NOW() - INTERVAL '1 hour'`); err != nil {
+		return nil, fmt.Errorf("walk queue: %w", err)
+	}
+	rows, err := r.client.pool.Query(ctx, `
+		SELECT creative_id, ad_id, COALESCE(account_id, 0), click_url, referer, queued_at
+		FROM spy.walk_queue WHERE queued_at > $1 ORDER BY queued_at`, since)
+	if err != nil {
+		return nil, fmt.Errorf("walk queue: %w", err)
+	}
+	defer rows.Close()
+	var out []WalkRequest
+	for rows.Next() {
+		var w WalkRequest
+		if err := rows.Scan(&w.CreativeID, &w.AdID, &w.AccountID, &w.ClickURL, &w.Referer, &w.QueuedAt); err != nil {
+			return nil, err
+		}
+		out = append(out, w)
+	}
+	return out, rows.Err()
+}
