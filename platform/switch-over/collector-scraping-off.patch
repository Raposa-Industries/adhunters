+	// 10. Run Sweeper Engine on main thread. With SWEEPER_CONCURRENCY=0
+	// Tracks scrapes instead: tracks-bridge writes its scrapes into spy and
+	// files each ad's link in spy.walk_queue, which feeds the walker here.
+	if cfg.SweeperConcurrency > 0 {
+		sweeperEngine.Start(ctx)
+	} else {
+		log.Printf("Scraping is off (SWEEPER_CONCURRENCY=0): Tracks feeds spy; the walker reads spy.walk_queue.")
+		feedWalker(ctx, landersRepo, funnelQueue)
+	}
 
 	log.Println("AdHunters Collector daemon shutdown complete.")
 }
 
+// feedWalker queues the links tracks-bridge files in spy.walk_queue for the
+// landing page walker, every 15 seconds, until ctx ends. The queue itself
+// decides whether an ad is due, as it did for the sweeper's links.
+func feedWalker(ctx context.Context, landers *db.LandersRepository, queue *funnel.DurableQueue) {
+	since := time.Now().Add(-10 * time.Minute)
+	tick := time.NewTicker(15 * time.Second)
+	defer tick.Stop()
+	for {
+		reqs, err := landers.WalkQueue(ctx, since)
+		if err != nil && ctx.Err() == nil {
+			log.Printf("[WALK-QUEUE] %v", err)
+		}
+		for _, r := range reqs {
+			queue.Enqueue(funnel.FunnelJob{
+				CreativeID:       r.CreativeID,
+				AdID:             r.AdID,
+				AccountID:        r.AccountID,
+				ClickURL:         r.ClickURL,
+				PublisherReferer: r.Referer,
+			})
+			since = r.QueuedAt
+		}
+		select {
+		case <-ctx.Done():
+			return
+		case <-tick.C:
+		}
+	}
+}
